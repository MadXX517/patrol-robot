<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="yeahbot_c2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import yeahbot_c2 urdf file -->
    <xacro:include filename="$(find car_urdf)/urdf/yeahbot_c2.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="yeahbot_c2.ros2_control.xacro" />


    <xacro:yeahbot_c2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
